<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <properties>
        <property id="backgroundEnabled" type="boolean">true</property>
        <property id="backgroundIntervalMinutes" type="number">15</property>
        <property id="demoDataEnabled" type="boolean">false</property>
        <property id="disconnectAlertEnabled" type="boolean">true</property>
    </properties>

    <strings>
        <string id="backgroundEnabledTitle">Background check</string>
        <string id="backgroundIntervalTitle">Check every</string>
        <string id="demoDataEnabledTitle">Demo data (debug)</string>
        <string id="disconnectAlertEnabledTitle">Disconnect alert</string>
    </strings>

    <settings>
        <setting propertyKey="@Properties.backgroundEnabled" title="@Strings.backgroundEnabledTitle">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.backgroundIntervalMinutes" title="@Strings.backgroundIntervalTitle">
            <settingConfig type="list">
                <listEntry value="15">15 minutes</listEntry>
                <listEntry value="30">30 minutes</listEntry>
                <listEntry value="60">60 minutes</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.demoDataEnabled" title="@Strings.demoDataEnabledTitle">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.disconnectAlertEnabled" title="@Strings.disconnectAlertEnabledTitle">
            <settingConfig type="boolean" />
        </setting>
    </settings>
</resources>
